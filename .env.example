# Neon deploy preenche estas variáveis em .env.local na raiz.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
PORT=3001
HOST=0.0.0.0
# Em produção HTTPS, cookies seguros são obrigatórios.
NODE_ENV=development
# Necessário na Vercel: segredo aleatório para autenticar o cron.
# CRON_SECRET=
# RECURRENCE_SCHEDULER=external
