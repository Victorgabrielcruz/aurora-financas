{
  "name": "@aurora/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "node scripts/prisma.mjs generate && node scripts/prisma.mjs generate --schema prisma/sqlite/schema.prisma",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.0",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
